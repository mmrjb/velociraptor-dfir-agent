[Unit]
Description=Velociraptor DFIR AI Preview
After=network.target

[Service]
Type=simple
User=vrdfir
Group=vrdfir
WorkingDirectory=/opt/vr-dfir-ai-preview/0.5.0a1
ExecStart=/opt/vr-dfir-ai-preview/0.5.0a1/venv/bin/vr-dfir ui --env-file /opt/vr-dfir-ai-preview/0.5.0a1/preview.env --host 127.0.0.1 --port 8766
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
